# MongoDB Atlas connection string (spec: MongoDB + Mongoose)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/asr

# Token signing secret (JWT)
JWT_SECRET=

# Encrypts student Gemini API keys at rest (AES-256-GCM). Use a long random string.
ENCRYPTION_KEY=

# Cloudinary (raw PDF storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server port
PORT=3000